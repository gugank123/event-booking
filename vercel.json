{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix eventflow-django-app/frontend install",
  "buildCommand": "npm --prefix eventflow-django-app/frontend run build",
  "outputDirectory": "eventflow-django-app/frontend/dist",
  "rewrites": [{ "source": "/((?!assets/).*)", "destination": "/index.html" }]
}
