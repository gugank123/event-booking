DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# MySQL connection (local server on 3306)
MYSQL_DATABASE=eventflow
MYSQL_USER=eventflow
MYSQL_PASSWORD=your-mysql-app-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# --- Railway MySQL via TCP Proxy (takes precedence when DB_HOST is set) ---
# DB_HOST = Railway TCP proxy domain (e.g. xxx.proxy.rlwy.net)
# DB_PORT = Railway TCP proxy port (e.g. 24576)
# DB_NAME = MySQL database name (e.g. railway)
# DB_USER = MySQL username (e.g. root)
# DB_PASSWORD = MySQL password
# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# --- Hosted MySQL (Railway/Aiven) ---
# Option A (recommended): single service URI from the provider dashboard.
# Example: mysql://root:PASSWORD@host:port/railway
# MYSQL_URL=

# Provider requires SSL with its CA cert. Either:
#   1. Save it as backend/ca.pem (auto-detected, git-ignored), or
#   2. Set MYSQL_SSL_CA to the file path, or
#   3. Paste the whole PEM text into MYSQL_SSL_CA_CONTENT (for Render).
# MYSQL_SSL_CA=
# MYSQL_SSL_CA_CONTENT=

# Google Sign-In: OAuth 2.0 Web client ID from
# https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email (transactional). Console backend prints mail to the Django log.
# For real mail set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# plus the SMTP settings below (Gmail needs an App Password).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=EventFlow <noreply@eventflow.dev>

# Links inside emails + public contact details for the Help page.
FRONTEND_URL=http://localhost:5173
SUPPORT_EMAIL=support@eventflow.dev
SUPPORT_PHONE=

# --- Payments (Razorpay, INR) — TEST keys for development, LIVE keys only in prod ---
# Get keys at https://dashboard.razorpay.com/app/keys (Mode: Test).
# NEVER commit real keys. Secret stays on the backend; the frontend receives
# only the public key_id per order from /api/payments/create-order/.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: comma-separated IPs allowed to call /api/payments/webhook/
# PAYMENT_WEBHOOK_ALLOWED_IPS=

# --- Booking money math & policy ---
PLATFORM_FEE_PERCENT=2.0
TAX_PERCENT=0.0
SEAT_HOLD_MINUTES=8
CANCELLATION_WINDOW_HOURS=24
